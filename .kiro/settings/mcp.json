{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    },
    "renewright": {
      "command": "python",
      "args": [
        ".kiro/mcp/renewright.py"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": [
        "list_members",
        "member_status",
        "wallet_months",
        "sms_reminder",
        "triage"
      ]
    }
  }
}
