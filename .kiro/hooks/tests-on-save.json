{
  "version": "v1",
  "hooks": [
    {
      "name": "wallet-tests-on-save",
      "trigger": "PostFileSave",
      "matcher": "src[\\\\/]proofkit[\\\\/]wallet[\\\\/].*\\.py$",
      "action": {
        "type": "command",
        "command": "python .kiro/hooks/run_tests.py tests/unit/wallet -q -p no:cacheprovider"
      },
      "timeout": 120
    },
    {
      "name": "integration-tests-on-save",
      "trigger": "PostFileSave",
      "matcher": "src[\\\\/]proofkit[\\\\/]integration[\\\\/].*\\.py$",
      "action": {
        "type": "command",
        "command": "python .kiro/hooks/run_tests.py tests/integration -q -p no:cacheprovider -k \"not end_to_end\""
      },
      "timeout": 120
    }
  ]
}
